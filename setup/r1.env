# R1 环境的统一配置：所有脚本都会读取这个文件。
# 第一次使用只需要改「1. 机器」和「2. 密码」两节。

# ---------- 1. 机器（必须改）----------
VM_HOST=bigdata01                  # 虚拟机主机名
VM_IP=172.16.250.100              # 改成你在 netplan 里设的静态 IP
VM_SUBNET=172.16.x.0/24            # 改成同一网段；Doris 靠它选网卡

# ---------- 2. 密码（必须改，只用于这台练习虚拟机）----------
MYSQL_APP_USER=r1                  # 业务库和 Flink CDC 共用的 MySQL 账号
MYSQL_APP_PASSWORD=CHANGE_ME       # 改成你自己的密码（不要用引号、空格和 | & \ 这几个字符）

# ---------- 3. 版本（2026-10-25 核对过下载地址）----------
KAFKA_VERSION=4.3.2
KAFKA_SCALA_VERSION=2.13
FLINK_VERSION=1.20.5
HBASE_VERSION=2.6.7
DORIS_VERSION=4.0.8
FLINK_KAFKA_CONNECTOR_VERSION=3.4.0-1.20
FLINK_MYSQL_CDC_VERSION=3.7.0-1.20
FLINK_HBASE_CONNECTOR_VERSION=4.0.0-1.19   # 官方最新只发布到适配 Flink 1.19 的版本，冒烟测试会验证它在 1.20 上能否用
FLINK_DORIS_CONNECTOR_VERSION=26.3.0
MYSQL_JDBC_VERSION=8.0.33                  # Flink CDC 不自带 MySQL 驱动（许可证原因），要单独下载
HADOOP_CLIENT_VERSION=3.3.6                # HBase 连接器运行时要用 Hadoop 的类；用官方打包好的客户端 jar，不用装整个 Hadoop

# ---------- 4. 下载源（国内镜像优先，失败自动换下一个）----------
APACHE_MIRRORS="https://mirrors.aliyun.com/apache https://archive.apache.org/dist"
MAVEN_MIRRORS="https://maven.aliyun.com/repository/public https://repo.maven.apache.org/maven2"
DORIS_DOWNLOAD_BASE=https://apache-doris-releases.oss-accelerate.aliyuncs.com
PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/

# ---------- 5. 目录 ----------
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
SOFT_DIR=/opt/software             # 安装包
MODULE_DIR=/opt/module             # 解压后的组件
DATA_DIR=/data                     # 数据、日志、checkpoint
KAFKA_HOME=$MODULE_DIR/kafka       # 下面四个都是指向具体版本目录的软链接
FLINK_HOME=$MODULE_DIR/flink
HBASE_HOME=$MODULE_DIR/hbase
DORIS_HOME=$MODULE_DIR/doris
GRAFANA_VERSION=12.3.0             # 可选的实时大屏（07-grafana.sh）；虚拟机上旧的 r1.env 没有这两行也行，脚本有同样的默认值
GRAFANA_HOME=$MODULE_DIR/grafana
PY_VENV=$HOME/venvs/r1

# ---------- 6. 内存预算（按 16GB 虚拟机分配，合计约 12–13GB）----------
KAFKA_HEAP=1G
HBASE_HEAP=1G
FLINK_JM_MEMORY=1600m
FLINK_TM_MEMORY=4096m
FLINK_TM_SLOTS=4
DORIS_FE_HEAP=2048m                # 默认 8G
DORIS_BE_JVM_HEAP=1024m            # 默认 2G
DORIS_BE_MEM_LIMIT=4G              # 默认是物理内存的 90%，不改会把虚拟机内存吃光
MYSQL_BUFFER_POOL=256M
