    {
      "id": 9,
      "type": "bargauge",
      "title": "购买次数最多的 10 个类目",
      "description": "dws_traffic_category_1m 按类目汇总",
      "datasource": {
        "type": "mysql",
        "uid": "doris-r1"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "doris-r1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CONCAT('类目 ', CAST(category_id AS STRING)) AS category, SUM(buy_cnt) AS buy FROM dws_traffic_category_1m GROUP BY category_id ORDER BY buy DESC LIMIT 10"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "转化漏斗",
      "description": "全部时间合计；条长按浏览量的比例画",
      "datasource": {
        "type": "mysql",
        "uid": "doris-r1"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "doris-r1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT '1 浏览' AS step, SUM(pv) AS cnt FROM dws_traffic_category_1m UNION ALL SELECT '2 加购', SUM(cart_cnt) FROM dws_traffic_category_1m UNION ALL SELECT '3 收藏', SUM(fav_cnt) FROM dws_traffic_category_1m UNION ALL SELECT '4 购买', SUM(buy_cnt) FROM dws_traffic_category_1m ORDER BY step"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "各层数据新鲜度",
      "description": "回放时，各层最新数据的事件时间越接近越好。ODS 走 Routine Load，可能短暂落后",
      "datasource": {
        "type": "mysql",
        "uid": "doris-r1"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "doris-r1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'ODS 明细（Routine Load）' AS `层`, FROM_MILLISECOND(MAX(ts)) AS `最新数据` FROM ods_user_behavior UNION ALL SELECT 'DWS 流量（Flink SQL）', MAX(window_start) FROM dws_traffic_category_1m UNION ALL SELECT 'DWS 交易（Flink CDC）', MAX(minute_start) FROM dws_trade_1m UNION ALL SELECT 'DWS 计数（DataStream）', MAX(window_start) FROM dws_behavior_1m_stream"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "每日明细",
      "description": "和 ads_dashboard.sql 第 1、3 项同口径",
      "datasource": {
        "type": "mysql",
        "uid": "doris-r1"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "doris-r1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DATE_FORMAT(t.dt, '%Y-%m-%d') AS `日期`, t.pv AS `浏览`, u.uv AS `访客`, t.cart AS `加购`, t.fav AS `收藏`, t.buy AS `购买行为`, d.orders AS `已支付订单`, d.gmv AS `GMV（元）`, d.refunds AS `退款单` FROM (SELECT DATE(window_start) AS dt, SUM(pv) pv, SUM(cart_cnt) cart, SUM(fav_cnt) fav, SUM(buy_cnt) buy FROM dws_traffic_category_1m GROUP BY DATE(window_start)) t LEFT JOIN (SELECT DATE(window_start) AS dt, BITMAP_UNION_COUNT(user_id) uv FROM dws_uv_bitmap_1m GROUP BY DATE(window_start)) u ON t.dt = u.dt LEFT JOIN (SELECT DATE(minute_start) AS dt, SUM(order_cnt) orders, SUM(gmv) gmv, SUM(refund_cnt) refunds FROM dws_trade_1m GROUP BY DATE(minute_start)) d ON t.dt = d.dt ORDER BY t.dt"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    }
  ]
}